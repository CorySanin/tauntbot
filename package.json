{
  "name": "tauntbot",
  "version": "4.0.13",
  "description": "Celebrate your victories!",
  "keywords": [
    "discord",
    "audio",
    "bot"
  ],
  "homepage": "https://taunt.bot",
  "bugs": {
    "url": "https://github.com/CorySanin/tauntbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorySanin/tauntbot.git"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Cory Sanin",
    "email": "corysanin@outlook.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./distribution/src/module.d.ts",
      "import": "./distribution/src/module.js"
    }
  },
  "types": "./distribution/src/module.d.ts",
  "bin": {
    "tauntbot": "./distribution/src/index.js",
    "tauntbot1t": "./distribution/src/main.js"
  },
  "files": [
    "distribution"
  ],
  "scripts": {
    "build": "npx tsc && chmod +x ./distribution/src/index.js ./distribution/src/main.js",
    "clean": "rm -rf ./distribution",
    "start": "node ./distribution/src/index.js",
    "watch": "npx tsc -w"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@sindresorhus/tsconfig": "8.1.0",
    "@top-gg/sdk": "^3.1.6",
    "bufferutil": "^4.1.0",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "json5": "2.2.3",
    "log4js": "^6.9.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^25.4.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
